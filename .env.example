# Required runtime secrets.
# OAuth client IDs are kept here too by request, even though they are not as sensitive as client secrets.
# Everything non-sensitive lives in src/lib/wcl-github/config.ts.

WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
WCL_DATA_REPO_TOKEN=
WCL_REFRESH_SECRET=

# Optional non-secret overrides. Usually do not use these; edit config.ts instead.
# WCL_DATA_REPO_OWNER=LihvoDruida
# WCL_DATA_REPO_NAME=mistblossom-wcl-data
# WCL_DATA_REPO_BRANCH=main
# WCL_DATA_PREFIX=data/wcl
