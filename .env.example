# GitHub Actions secrets for GitHub-only WCL collector.
# Add these in:
# Repository → Settings → Secrets and variables → Actions → Secrets

WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=

