# GitHub Actions Secrets
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=

# Optional local/manual-run overrides for budget-aware hourly refresh.
# Defaults are in src/lib/wcl-github/config.ts
# WCL_MEMBER_BATCH_SIZE=8
# WCL_MIN_MEMBER_REFRESH_AGE_HOURS=12
# WCL_MAX_FIGHTS_PER_RUN=8
# WCL_MAX_QUERIES_PER_RUN=28
# WCL_MIN_FIGHT_DURATION_MS=30000
# WCL_TARGET_NEW_PULLS_PER_MEMBER=1
# WCL_REQUEST_DELAY_MS=1200
# WCL_REPORT_LIMIT=8
# WCL_MAX_REPORT_PAGES=1
